# Caddyfile — Rabta AI Production Reverse Proxy
# Supports both direct IP access (:80) and automatic HTTPS on custom domain ({$DOMAIN})

:80, {$DOMAIN} {
    # Main API backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # WhatsApp webhook
    handle /webhooks/* {
        reverse_proxy backend:8000
    }

    # Health check
    handle /health {
        reverse_proxy backend:8000
    }

    # WhatsApp gateway QR admin UI
    handle /gateway/* {
        reverse_proxy gateway:3001
    }

    # Static frontend (landing, dashboard, onboard)
    handle /* {
        reverse_proxy backend:8000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}
