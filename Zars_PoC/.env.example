# ==============================================================================
# RABTA AI - Environment Configuration (.env.example)
# Copy this file to .env and fill in the required credentials before deploying.
# ==============================================================================

# ── 1. General & Domain ────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info
SECRET_KEY=generate_a_random_64_char_secret_key_here
DOMAIN=api.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ── 2. PostgreSQL Database (Docker Container) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=rabta_dev

# Internal URL for docker-compose (used automatically by backend container):
# DATABASE_URL=postgresql+asyncpg://postgres:your_strong_db_password_here@postgres:5432/rabta_dev

# ── 3. AI Brain (Google Gemini) ───────────────────────────────────────────────
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── 4. Voice Transcription (Deepgram) ─────────────────────────────────────────
# Get key at: https://console.deepgram.com/ ($200 free credit)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── 5. WhatsApp Cloud API / 360dialog (Optional if using Baileys QR Gateway) ──
# Get credentials at: https://developers.facebook.com/ or 360dialog Hub
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=rabta_webhook_verify_token_12345
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── 6. Off-Server Database Backups (Cloudflare R2 / AWS S3) ───────────────────
# Get free R2 credentials at: https://dash.cloudflare.com/ -> R2 Object Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=rabta-backups

