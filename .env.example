# ==============================================================================
# Nuncio by ZeroPointIntel — Production Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env or .env.production and provide real secrets.
# NEVER commit .env to source control.
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database & Tenant Row-Level Security (RLS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/nuncio_db?sslmode=require

# ------------------------------------------------------------------------------
# 2. Official Meta Tech Provider & WhatsApp Business Cloud API
# ------------------------------------------------------------------------------
META_APP_ID=1584644373301704
META_APP_SECRET=your_meta_app_secret_here
META_SYSTEM_USER_TOKEN=your_permanent_system_user_token_here
WHATSAPP_WABA_ID=1406719968069623
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_high_entropy_verify_token_here

# ------------------------------------------------------------------------------
# 3. Stripe Payments & In-Chat Checkout
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. LLM Engines & Voice Note Processing (EU / Multilingual Dialects)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ------------------------------------------------------------------------------
# 5. Security, Admin Control Plane & Redis Queue
# ------------------------------------------------------------------------------
ADMIN_API_KEY=your_secure_admin_api_key_here
REDIS_URL=redis://localhost:6379
