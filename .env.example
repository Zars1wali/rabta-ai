# ==============================================================================
# Nuncio / Rabta AI - Master Environment Configuration Template (.env.example)
# Copy this file to .env and provide verified production credentials before starting.
# NEVER commit .env or real secrets to source control.
# ==============================================================================

# ── 1. Application & Runtime ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://nuncio.zeropointintel.com

# ── 2. PostgreSQL Database ─────────────────────────────────────────────────────
# PostgreSQL 16 connection URL with SSL enabled for cloud production deployments
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/nuncio?sslmode=require

# ── 3. Backoffice & Security Keys ──────────────────────────────────────────────
# Master API Key for Platform Operator administration (Generate with: openssl rand -hex 32)
ADMIN_API_KEY=
# Merchant & Backoffice JWT signing secret (Generate with: openssl rand -hex 32)
JWT_SIGNING_SECRET=
# HMAC secret salt for anonymous 24h visitor identity hashing in metering
METERING_HMAC_SECRET=

# ── 4. AI Inference Providers (EU Compliance / Paid Tiers Only) ────────────────
# Google Gemini Paid API Key (Gemini 3.x Flash-Lite / 2.0 Flash)
GEMINI_API_KEY=
# Mistral AI API Key (Mandatory for Europe Data Residency Tier)
MISTRAL_API_KEY=

# ── 5. Voice Transcription (Deepgram Nova-3) ───────────────────────────────────
DEEPGRAM_API_KEY=

# ── 6. Stripe Payments & Subscriptions ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── 7. Meta Tech Provider & WhatsApp Cloud API ─────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ── 8. Notifications & Alerts ──────────────────────────────────────────────────
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TARGET=ops@zeropointintel.com
